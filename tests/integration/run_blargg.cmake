if(NOT EXISTS "${ROM}")
  message("fixture missing: ${ROM} (run scripts/fetch-test-roms.sh)")
  cmake_language(EXIT 77)
endif()
execute_process(COMMAND "${CLI}" blargg "${ROM}" --max-frames 6000 RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
message("${out}${err}")
if(NOT rc EQUAL 0)
  message(FATAL_ERROR "blargg test failed with code ${rc}")
endif()
