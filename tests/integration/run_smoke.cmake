if(NOT EXISTS "${ROM}")
  message("fixture missing: ${ROM} (run scripts/fetch-test-roms.sh)")
  cmake_language(EXIT 77)
endif()
# Two runs must agree (determinism) and the frame must differ from an all-backdrop screen.
execute_process(COMMAND "${CLI}" run "${ROM}" --frames 300 RESULT_VARIABLE rc1 OUTPUT_VARIABLE o1)
execute_process(COMMAND "${CLI}" run "${ROM}" --frames 300 RESULT_VARIABLE rc2 OUTPUT_VARIABLE o2)
execute_process(COMMAND "${CLI}" run "${ROM}" --frames 1 OUTPUT_VARIABLE o0)
message("${o1}")
string(REGEX MATCH "hash=[0-9a-f]+" h1 "${o1}")
string(REGEX MATCH "hash=[0-9a-f]+" h2 "${o2}")
string(REGEX MATCH "hash=[0-9a-f]+" h0 "${o0}")
if(NOT rc1 EQUAL 0 OR NOT h1 STREQUAL h2 OR h1 STREQUAL h0)
  message(FATAL_ERROR "smoke test failed: ${h1} vs ${h2} (first frame ${h0})")
endif()
