<Page
    x:Class="NesXbox.Views.LanImportPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Spacing="12" MaxWidth="900" HorizontalAlignment="Left">
        <TextBlock Text="Import over your home network" Style="{StaticResource PageTitle}" />
        <TextBlock Style="{StaticResource StatusText}"
                   Text="Use this if the USB drive does not show up. On a phone or PC on the same network, open the address below in a browser, enter the code and pick .nes files. Or from Ubuntu run: scripts/lan-upload.py ADDRESS CODE game.nes" />
        <TextBlock x:Name="UrlText" FontSize="40" FontWeight="Bold" IsTextSelectionEnabled="True" />
        <TextBlock x:Name="CodeText" FontSize="32" />
        <TextBlock x:Name="StatusLine" Style="{StaticResource StatusText}" />
        <ListView x:Name="Received" Header="Received this session" MaxHeight="300" SelectionMode="None" />
        <TextBlock Style="{StaticResource StatusText}" FontSize="15"
                   Text="The receiver only runs while this page is open, accepts devices on your local network only, and needs the code shown here. Leaving the page turns it off." />
    </StackPanel>
</Page>
