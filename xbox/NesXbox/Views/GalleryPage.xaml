<Page
    x:Class="NesXbox.Views.GalleryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:NesXbox.ViewModels">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,0,0,12">
            <ComboBox x:Name="FilterBox" Header="Show" MinWidth="200" FontSize="18"
                      SelectedIndex="{x:Bind ViewModel.FilterIndex, Mode=TwoWay}">
                <ComboBoxItem Content="All" />
                <ComboBoxItem Content="Favorites" />
                <ComboBoxItem Content="Recently played" />
                <ComboBoxItem Content="Recently added" />
            </ComboBox>
            <ComboBox x:Name="SortBox" Header="Sort by" MinWidth="200" FontSize="18"
                      SelectedIndex="{x:Bind ViewModel.SortIndex, Mode=TwoWay}">
                <ComboBoxItem Content="Title" />
                <ComboBoxItem Content="Date added" />
                <ComboBoxItem Content="Last played" />
            </ComboBox>
            <!-- On Xbox a TextBox opens the system on-screen keyboard. -->
            <TextBox x:Name="SearchBox" Header="Search" Width="300" FontSize="18" PlaceholderText="Title or developer"
                     Text="{x:Bind ViewModel.Search, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Text="{x:Bind ViewModel.CountText, Mode=OneWay}" VerticalAlignment="Bottom" Margin="12,0,0,8"
                       Style="{StaticResource StatusText}" />
        </StackPanel>

        <GridView x:Name="GamesGrid" Grid.Row="1" ItemsSource="{x:Bind ViewModel.Cards}" IsItemClickEnabled="True"
                  ItemClick="Grid_ItemClick" SelectionMode="Single" Padding="0,4,0,48">
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="vm:GameCard">
                    <Grid Width="200" Height="250" Background="{StaticResource PanelBrush}" Margin="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="160" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <!-- Generated cartridge placeholder, replaced by cached cover art when present. -->
                        <Border Background="{x:Bind PlaceholderBrush, Mode=OneWay}" Visibility="{x:Bind PlaceholderVisibility, Mode=OneWay}">
                            <Grid>
                                <TextBlock Text="{x:Bind Initials, Mode=OneWay}" FontSize="56" FontWeight="Bold" HorizontalAlignment="Center"
                                           VerticalAlignment="Center" Foreground="White" />
                                <TextBlock Text="NES" FontSize="14" Margin="8" Foreground="White" Opacity="0.7"
                                           HorizontalAlignment="Left" VerticalAlignment="Bottom" />
                            </Grid>
                        </Border>
                        <Image Source="{x:Bind Cover, Mode=OneWay}" Stretch="UniformToFill" />
                        <TextBlock Text="&#xE735;" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="Gold" Margin="8"
                                   HorizontalAlignment="Right" VerticalAlignment="Top" Visibility="{x:Bind FavoriteVisibility, Mode=OneWay}" />
                        <StackPanel Grid.Row="1" Padding="10,6">
                            <TextBlock Text="{x:Bind Title, Mode=OneWay}" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{x:Bind Status, Mode=OneWay}" FontSize="14" Opacity="{x:Bind StatusOpacity, Mode=OneWay}" />
                            <TextBlock Text="{x:Bind Subtitle, Mode=OneWay}" FontSize="14" Opacity="0.6" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>

        <TextBlock Grid.Row="1" Text="{x:Bind ViewModel.EmptyText, Mode=OneWay}" Visibility="{x:Bind ViewModel.EmptyVisibility, Mode=OneWay}"
                   FontSize="24" TextWrapping="Wrap" MaxWidth="700" HorizontalAlignment="Center" VerticalAlignment="Center"
                   TextAlignment="Center" Foreground="{StaticResource MutedTextBrush}" />
    </Grid>
</Page>
