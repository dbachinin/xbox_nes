<Page
    x:Class="NesXbox.Views.CatalogPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:NesXbox.ViewModels">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,0,0,8">
            <ComboBox x:Name="SourceBox" Header="Source" MinWidth="240" FontSize="18"
                      SelectedIndex="{x:Bind ViewModel.SourceIndex, Mode=TwoWay}">
                <ComboBoxItem Content="Homebrew Hub (NES)" />
                <ComboBoxItem Content="Curated GitHub releases" />
            </ComboBox>
            <TextBox x:Name="SearchBox" Header="Search title" Width="300" FontSize="18"
                     Text="{x:Bind ViewModel.Search, Mode=TwoWay}" KeyDown="SearchBox_KeyDown" />
            <Button Content="Search" Style="{StaticResource BigButton}" VerticalAlignment="Bottom" Click="Search_Click" />
        </StackPanel>

        <TextBlock Grid.Row="1" Text="{x:Bind ViewModel.Status, Mode=OneWay}" Style="{StaticResource StatusText}" Margin="0,0,0,8" />

        <ListView x:Name="CatalogList" Grid.Row="2" ItemsSource="{x:Bind ViewModel.Items}" IsItemClickEnabled="True" ItemClick="List_ItemClick"
                  SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:CatalogItem">
                    <Grid Padding="4,8" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="160" Height="120" Background="{StaticResource PanelBrush}">
                            <Image Source="{x:Bind Cover}" Visibility="{x:Bind CoverVisibility}" Stretch="Uniform" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind Title}" FontSize="22" FontWeight="SemiBold" />
                            <TextBlock Text="{x:Bind Developer}" FontSize="16" Opacity="0.8" />
                            <TextBlock Text="{x:Bind Rights}" FontSize="15" Opacity="0.7" TextWrapping="Wrap" />
                            <TextBlock Text="{x:Bind Source}" FontSize="13" Opacity="0.5" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Width="220">
                            <TextBlock Text="{x:Bind State, Mode=OneWay}" FontSize="18" TextWrapping="Wrap" TextAlignment="Right" />
                            <ProgressBar Value="{x:Bind Progress, Mode=OneWay}" Maximum="100" Margin="0,6,0,0" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
            <ListView.Footer>
                <Button Content="Load more" Style="{StaticResource BigButton}" Margin="0,12" Click="LoadMore_Click"
                        Visibility="{x:Bind ViewModel.LoadMoreVisibility, Mode=OneWay}" />
            </ListView.Footer>
        </ListView>
    </Grid>
</Page>
