<Page
    x:Class="NesXbox.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Spacing="16" MaxWidth="900" HorizontalAlignment="Left">
            <TextBlock Text="Settings" Style="{StaticResource PageTitle}" />
            <ToggleSwitch x:Name="RecursiveToggle" Header="Scan USB subfolders (up to 3 levels)" FontSize="18" Toggled="Recursive_Toggled" />
            <ToggleSwitch x:Name="AspectToggle" Header="8:7 pixel aspect ratio (otherwise sharp square pixels)" FontSize="18" Toggled="Aspect_Toggled" />
            <ToggleSwitch x:Name="DebugToggle" Header="Show performance overlay in games (FPS, core time, dropped frames)" FontSize="18" Toggled="Debug_Toggled" />
            <Button Content="Clear catalog cache" Style="{StaticResource BigButton}" Click="ClearCache_Click" />
            <TextBlock x:Name="StorageText" Style="{StaticResource StatusText}" />
            <TextBlock Style="{StaticResource StatusText}" FontSize="16">
                <Run Text="Controls in game (NES layout): Xbox A = NES B, Xbox B = NES A, X = turbo B, Y = turbo A, Menu = Start, View = Select, D-pad / left stick = move." />
                <LineBreak />
                <Run Text="RT opens the pause menu (Resume, Reset, Quit to library); LT opens the save-state menu (Save state, Load state). The same trigger or B returns to the game." />
                <LineBreak />
                <LineBreak />
                <Run Text="NES / Xbox is an independent emulator for Xbox Developer Mode. It ships no commercial games. Catalog entries keep their source and license; downloads are offered only where the license allows redistribution." />
            </TextBlock>
        </StackPanel>
    </ScrollViewer>
</Page>
