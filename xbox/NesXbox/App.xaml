<Application
    x:Class="NesXbox.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <SolidColorBrush x:Key="AccentBrush" Color="#FFE4002B" />
            <SolidColorBrush x:Key="PanelBrush" Color="#FF1E1E24" />
            <SolidColorBrush x:Key="MutedTextBrush" Color="#FFB0B0B8" />

            <Style x:Key="PageTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="34" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="0,0,0,12" />
            </Style>
            <Style x:Key="StatusText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="20" />
                <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="BigButton" TargetType="Button">
                <Setter Property="FontSize" Value="20" />
                <Setter Property="Padding" Value="20,10" />
                <Setter Property="Margin" Value="0,0,12,0" />
                <Setter Property="MinWidth" Value="140" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
