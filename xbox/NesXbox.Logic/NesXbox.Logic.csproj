<Project Sdk="Microsoft.NET.Sdk">
  <!-- Platform-neutral shell logic. netstandard2.0 so the UWP app (.NET Native) can reference it
       and Linux can unit-test it with no Windows SDK. No NuGet dependencies on purpose. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>8.0</LangVersion>
    <Nullable>disable</Nullable>
    <RootNamespace>NesXbox.Logic</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
</Project>
